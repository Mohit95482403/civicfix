# CivicFix Backend API — Environment Configuration Template
# Duplicate this file to .env and provide your local credentials.
# NEVER commit .env to version control!

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration (Comma-separated list of allowed origins)
FRONTEND_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Supabase Configuration (Day 4 Integration)
# Replace with your actual Supabase project settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
# Server-only service_role key for backend elevated operations (KEEP STRICTLY CONFIDENTIAL)
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# Logging Configuration
LOG_LEVEL=info
