# CivicFix Staff Web Portal — Environment Configuration Template
# Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER place secret service-role keys here!

# Backend REST API Gateway URL
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Supabase Public Client Credentials (Day 6 Auth Integration)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key
