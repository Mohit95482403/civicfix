{
  "name": "civicfix-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "CivicFix — Startup-level civic issue reporting and resolution tracking platform",
  "scripts": {
    "dev:backend": "npm --prefix backend run dev",
    "dev:staff": "npm --prefix staff-portal run dev",
    "dev:admin": "npm --prefix admin-portal run dev",
    "dev:prototype": "npm --prefix design-prototype run dev",
    "build:backend": "npm --prefix backend run build",
    "build:staff": "npm --prefix staff-portal run build",
    "build:admin": "npm --prefix admin-portal run build",
    "build:prototype": "npm --prefix design-prototype run build",
    "build:all": "npm run build:backend && npm run build:staff && npm run build:admin",
    "typecheck:backend": "npm --prefix backend run typecheck",
    "typecheck:staff": "npm --prefix staff-portal run typecheck",
    "typecheck:admin": "npm --prefix admin-portal run typecheck",
    "check:all": "npm run typecheck:backend && npm run typecheck:staff && npm run typecheck:admin"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=20.0.0"
  }
}
